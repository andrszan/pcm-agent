# OpenAI-compatible 决策模型配置
LLM_BASE_URL=https://example.invalid/compatible-mode/v1
LLM_API_KEY=replace-with-local-secret
LLM_MODEL=qwen3.7-max-preview
# 可选；留空不发送 reasoning.effort，非空值由实际 AI-compatible 服务支持
LLM_MODEL_EFFORT=

# 可选：模型提供商切换。配置 PCM_PROVIDER 后，程序先读本文件，
# 再叠加 .env.d/<PCM_PROVIDER>.env 中的 LLM_* 与 PCM_AGENT_* 配置（后者优先），
# 模型策略同步改用 model-policy.<PCM_PROVIDER>.toml；两者必须存在。
# 留空时直接使用本文件与 model-policy.toml。进程环境变量优先于本文件。
PCM_PROVIDER=

# Claude Agent SDK 使用 Anthropic Messages 协议和 Bearer 认证；Base URL 不包含 /v1
PCM_AGENT_BASE_URL=http://localhost:8317
PCM_AGENT_AUTH_TOKEN=replace-with-local-secret
# Claude Code 原生自动压缩窗口，必须是正整数
CLAUDE_CODE_AUTO_COMPACT_WINDOW=500000
# Claude Code 单次调用最大重试次数，非负整数；0 禁用重试，默认 10，可按需改为 15
CLAUDE_CODE_MAX_RETRIES=10
# Claude Agent 的真实模型与 effort 统一配置在 model-policy.toml

# 可选：所有产品共用的 SDK 代理，使用本机实际可达的 HTTP 代理地址；直连环境留空
# 进程环境优先于本文件；同一来源小写优先；空值视为未配置
HTTP_PROXY=
HTTPS_PROXY=
# 有代理时建议填 localhost,127.0.0.1,::1，并保留实际需要的内网域名
NO_PROXY=

# 所有产品项目的父目录；可由 --workspace-root 覆盖
PCM_WORKSPACE_ROOT=/absolute/path/to/products

# 当前 PCM Demo checkout 同时执行的产品项目上限
PCM_MAX_CONCURRENT_PROJECTS=2

# 第 3 步使用的模板候选目录 JSON；可由 --catalog-path 覆盖
PCM_TEMPLATE_CATALOG=/absolute/path/to/catalog.json

# 第 1 步使用的固定开发管理模板仓库；单次运行不可覆盖
PCM_TEMPLATE_REPOSITORY=git@gitlab.com:baiyiyu/andrszan/pcm-agent-skills.git

# 第 1 步写入 AI Agent 产品开发工作区根目录的受保护工具配置；必须是可读普通文件的绝对路径
PCM_AGENT_WORKSPACE_ENV_FILE=/absolute/path/to/agent-workspace.env

# 项目准备核验使用的可信开发资源清单；必须是可读普通文件的绝对路径
PCM_DEV_RESOURCE_LIST=/absolute/path/to/dev-resource-list.md
