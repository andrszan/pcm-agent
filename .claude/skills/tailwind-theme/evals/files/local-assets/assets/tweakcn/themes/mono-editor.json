{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "mono-editor",
  "type": "registry:style",
  "cssVars": {
    "theme": {
      "font-sans": "IBM Plex Sans, Noto Sans SC, sans-serif",
      "font-serif": "Source Serif 4, Noto Serif SC, serif",
