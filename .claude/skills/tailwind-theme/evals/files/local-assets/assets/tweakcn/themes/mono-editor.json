      "text-base": "0.9375rem",
      "leading-base": "1.55",
      "tracking-normal": "-0.006em",
      "radius": "0",
      "shadow-sm": "0 0 0 oklch(0 0 0 / 0)",
      "shadow-md": "0 0 0 oklch(0 0 0 / 0)",
      "border-width": "1px",
      "spacing": "0.25rem"
    },
    "light": {
      "background": "oklch(0.99 0 0)",
