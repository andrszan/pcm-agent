  "css": {
    "@layer base": {
      "body": {
        "fontFamily": "var(--theme-font-sans)",
        "fontSize": "var(--theme-text-base)",
        "lineHeight": "var(--theme-leading-base)",
        "letterSpacing": "var(--theme-tracking-normal)"
      }
    }
