      "text-base": "0.9375rem",
      "leading-base": "1.55",
      "tracking-normal": "-0.006em",
      "radius": "0.5rem",
      "shadow-sm": "0 1px 2px oklch(0.2 0.02 250 / 0.08)",
      "shadow-md": "0 6px 18px oklch(0.2 0.02 250 / 0.12)",
      "border-width": "1px",
      "spacing": "0.25rem"
    },
    "light": {
      "background": "oklch(0.985 0.004 240)", "foreground": "oklch(0.22 0.018 245)",
      "card": "oklch(1 0 0)", "card-foreground": "oklch(0.22 0.018 245)",
