# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local settings (per-user, not committed)
#.claude/settings.local.json

# editor files
.vscode/*
.idea/*

# local git worktrees
.worktrees/

# macOS
.DS_Store

# ignore files
/docs/ignore/

# 测试与 UI 浏览器验收截图
/.test-screenshots/

# playwright
.playwright/
.playwright-cli/
.playwright-mcp/

# Python 测试覆盖率数据库
**/.coverage

# 根目录若产生 .env 不得入库；各子仓库另有各自规则
.env*
!.env.example

# 前后端为独立 Git 仓库，不由根仓库跟踪其内容
/frontend/
/backend/

# Claude worktrees
.claude/worktrees/

# Claude Agent Plugin runtime files
.agents/plugins/**/.in_use/
.agents/plugins/**/__pycache__/
.agents/plugins/**/*.pyc
.agents/plugins/**/.orphaned_at
